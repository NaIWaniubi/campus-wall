/* 自定义 TabBar：与全站视觉语言统一（白底 + 品牌绿），
   去掉深色渐变、四色选中态、流光与呼吸动画——
   深色渐变与青紫粉黄四色会让小程序看起来像另一个产品。 */

.tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  height: 104rpx;
  padding: 10rpx 14rpx 12rpx;
  background: #FFFFFF;
  border-top: 1rpx solid #E8ECEF;
  box-shadow: 0 -2rpx 12rpx rgba(17, 24, 39, 0.05);
  box-sizing: content-box;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
}

.tab-item {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  color: #9CA3AF;
}

.tab-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  transition: background-color .18s ease;
}

.tab-icon { width: 38rpx; height: 38rpx; }

.tab-label {
  margin-top: 4rpx;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.2;
}

/* 选中态统一为品牌绿 #16A085，不再按 Tab 位次变色 */
.is-active { color: #16A085; font-weight: 700; }
.is-active .tab-icon-wrap { background: rgba(22, 160, 133, 0.10); }

/* 中间发布键：品牌绿实心圆，去掉呼吸浮动动画 */
.tab-publish { transform: translateY(-16rpx); }
.tab-publish .tab-icon-wrap {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #16A085;
  box-shadow: 0 8rpx 20rpx rgba(22, 160, 133, 0.28);
}
.tab-publish .tab-icon { width: 42rpx; height: 42rpx; }
.tab-publish .tab-label { margin-top: 6rpx; color: #6B7280; }
.tab-publish.is-active .tab-icon-wrap { background: #16A085; }
.tab-publish.is-active .tab-label { color: #16A085; }
