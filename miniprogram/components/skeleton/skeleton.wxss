/* 骨架屏：token 化配色（var 带原 hex fallback，与全站组件惯例一致） */
.sk {
  background: linear-gradient(90deg, var(--color-bg-muted, #EFE8DA) 25%, var(--color-bg-soft, #fafafa) 37%, var(--color-bg-muted, #EFE8DA) 63%);
  background-size: 400% 100%;
  animation: sk-shimmer 1.4s ease infinite;
  border-radius: var(--radius-md, 12rpx);
}
@keyframes sk-shimmer {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}
@media (prefers-reduced-motion: reduce) {
  .sk { animation: none; }
}

.sk-row { display: flex; align-items: center; gap: var(--space-3, 16rpx); }
.sk-col { flex: 1; display: flex; flex-direction: column; gap: var(--space-2, 12rpx); }

.sk-avatar { width: 72rpx; height: 72rpx; border-radius: 50%; flex-shrink: 0; }
.sk-line { height: 28rpx; margin-bottom: var(--space-2, 12rpx); }
.sk-thin { height: 20rpx; }
.sk-title { height: 40rpx; margin-bottom: var(--space-4, 18rpx); }
.sk-band { height: 240rpx; margin: var(--space-2, 12rpx) 0 var(--space-4, 18rpx); }
.sk-tall { height: 320rpx; }
.sk-chip { width: 88rpx; height: 32rpx; border-radius: 999rpx; }

.sk-card {
  background: var(--color-bg-elevated, #ffffff);
  border-radius: var(--radius-xl, 22rpx);
  padding: var(--space-6, 24rpx);
  margin-bottom: var(--space-4, 18rpx);
}
.sk-foot { display: flex; gap: var(--space-6, 24rpx); margin-top: var(--space-3, 16rpx); }

/* 聊天气泡 */
.sk-msg-row { display: flex; margin-bottom: var(--space-4, 18rpx); }
.sk-msg-row.is-mine { justify-content: flex-start; }
.sk-msg-row:not(.is-mine) { justify-content: flex-end; }
.sk-bubble { width: 46%; height: 72rpx; border-radius: 24rpx; }
.sk-bubble--lg { height: 132rpx; }
