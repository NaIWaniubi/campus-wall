<view class="moderation-page">
  <view class="header">
    <text class="title">内容治理台</text>
    <text class="subtitle">审核队列 · 举报处理 · 运营数据一览</text>
    <view wx:if="{{role}}" class="role-chip">{{role === 'super_admin' ? '超级管理员' : '板块管理员'}}</view>
  </view>

  <!-- 数据卡 -->
  <view class="stats-grid" wx:if="{{cards.length}}">
    <view wx:for="{{cards}}" wx:key="key" class="stat-card {{item.accent ? 'accent' : ''}}">
      <text class="stat-value">{{item.value}}</text>
      <text class="stat-label">{{item.label}}</text>
    </view>
  </view>

  <!-- 主 Tab：意见反馈/用户管理为超管专属接口，仅超管显示 -->
  <view class="seg">
    <view class="seg-item {{mainTab === 'posts' ? 'active' : ''}}" bindtap="onMainTab" data-tab="posts">内容审核</view>
    <view class="seg-item {{mainTab === 'reports' ? 'active' : ''}}" bindtap="onMainTab" data-tab="reports">举报处理</view>
    <view wx:if="{{role === 'super_admin'}}" class="seg-item {{mainTab === 'feedback' ? 'active' : ''}}" bindtap="onMainTab" data-tab="feedback">意见反馈</view>
    <view wx:if="{{role === 'super_admin'}}" class="seg-item {{mainTab === 'users' ? 'active' : ''}}" bindtap="onMainTab" data-tab="users">用户管理</view>
  </view>

  <!-- ============ 内容审核 ============ -->
  <block wx:if="{{mainTab === 'posts'}}">
    <scroll-view scroll-x class="chips" enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{statusTabs}}"
        wx:key="key"
        class="chip {{activeStatus === item.key ? 'active' : ''}}"
        bindtap="onStatusTab"
        data-key="{{item.key}}"
      >{{item.name}}</view>
    </scroll-view>

    <view wx:for="{{posts}}" wx:key="id" class="card post-card">
      <view class="card-top">
        <text class="post-title">{{item.title}}</text>
        <text class="badge s-{{item.status}}">{{item.statusText}}</text>
      </view>
      <text class="post-content">{{item.content}}</text>
      <view class="meta">
        <text>{{item.sectionName}}</text>
        <text class="dot">·</text>
        <text>{{item.authorName}}（{{item.studentId}}）</text>
        <text class="dot">·</text>
        <text>{{item.timeText}}</text>
        <text wx:if="{{item.imageCount}}"> · {{item.imageCount}}图</text>
      </view>
      <view wx:if="{{item.rejectReason}}" class="reject-reason">驳回原因：{{item.rejectReason}}</view>
      <view wx:if="{{item.status === 'pending_review' || item.status === 'pending'}}" class="actions">
        <button size="mini" class="btn-primary" bindtap="onApprove" data-id="{{item.id}}">通过</button>
        <button size="mini" class="btn-danger" bindtap="onReject" data-id="{{item.id}}">驳回</button>
      </view>
    </view>

    <empty-state wx:if="{{posts.length === 0 && !postsLoading}}" text="该状态下暂无内容" customIcon="🗂️"></empty-state>
  </block>

  <!-- ============ 举报处理 ============ -->
  <block wx:if="{{mainTab === 'reports'}}">
    <scroll-view scroll-x class="chips" enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{reportTabs}}"
        wx:key="key"
        class="chip {{activeReportStatus === item.key ? 'active' : ''}}"
        bindtap="onReportTab"
        data-key="{{item.key}}"
      >{{item.name}}</view>
    </scroll-view>

    <view wx:for="{{reports}}" wx:key="id" class="card report-card">
      <view class="card-top">
        <text class="target">{{item.targetTypeText}} #{{item.targetId}}</text>
        <text wx:if="{{item.priority === 'high'}}" class="badge high">高优先</text>
        <text wx:elif="{{item.status === 'handled'}}" class="badge handled">已处理</text>
        <text wx:else class="badge pending-badge">待处理</text>
      </view>

      <!-- 匿名帖举报阈值警示条（仅管理端可见） -->
      <view wx:if="{{item.warnText}}" class="warn-bar">{{item.warnText}}</view>

      <text class="reason">举报原因：{{item.reason}}</text>
      <view class="meta">
        <text>举报人 {{item.reporterName}}（{{item.reporterStudentId}}）</text>
        <text wx:if="{{item.reportCount}}" class="count"> · 累计{{item.reportCount}}人举报</text>
        <text class="dot">·</text>
        <text>{{item.timeText}}</text>
      </view>
      <view wx:if="{{item.handleResult}}" class="handle-result">处理结果：{{item.handleResult}}</view>

      <view wx:if="{{item.status === 'pending'}}" class="actions">
        <button size="mini" class="btn-danger" bindtap="onHandleReport" data-id="{{item.id}}" data-action="delete_content">删除内容</button>
        <button size="mini" class="btn-warn" bindtap="onHandleReport" data-id="{{item.id}}" data-action="ban_user">封禁作者</button>
        <button size="mini" class="btn-ghost" bindtap="onHandleReport" data-id="{{item.id}}" data-action="dismiss">忽略</button>
      </view>
    </view>

    <empty-state wx:if="{{reports.length === 0 && !reportsLoading}}" text="暂无待处理举报" customIcon="🛡️"></empty-state>
  </block>

  <!-- ============ 意见反馈 ============ -->
  <block wx:if="{{mainTab === 'feedback'}}">
    <scroll-view scroll-x class="chips" enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{feedbackTabs}}"
        wx:key="key"
        class="chip {{activeFeedbackStatus === item.key ? 'active' : ''}}"
        bindtap="onFeedbackTab"
        data-key="{{item.key}}"
      >{{item.name}}</view>
    </scroll-view>

    <view wx:for="{{feedbacks}}" wx:key="id" class="card feedback-card">
      <view class="card-top">
        <text class="target">{{item.nickname}}（{{item.studentId}}）</text>
        <text class="badge {{item.status === 'closed' ? 'handled' : 'pending-badge'}}">{{item.statusText}}</text>
      </view>
      <text class="post-content">{{item.content}}</text>
      <view class="meta">
        <text>联系方式：{{item.contact}}</text>
        <text class="dot">·</text>
        <text>{{item.timeText}}</text>
      </view>
    </view>

    <empty-state wx:if="{{feedbacks.length === 0 && !feedbacksLoading}}" text="暂无反馈" customIcon="📮"></empty-state>
  </block>

  <!-- ============ 用户管理（精简版） ============ -->
  <block wx:if="{{mainTab === 'users'}}">
    <view class="hint-bar">🔒 重置密码 / 信誉调整为高危操作，完整管理请使用网页端</view>

    <view class="search-bar">
      <input
        class="search-input"
        value="{{userKeyword}}"
        placeholder="搜索账号 / 昵称"
        confirm-type="search"
        bindinput="onUserKeywordInput"
        bindconfirm="onUserSearch"
      />
      <button size="mini" class="btn-primary search-btn" bindtap="onUserSearch">搜索</button>
    </view>

    <view wx:for="{{users}}" wx:key="id" class="card user-card">
      <view class="card-top">
        <text class="target">{{item.nickname}}</text>
        <text class="badge {{item.isBanned ? 'banned' : ''}}">{{item.isBanned ? '已封禁' : '正常'}}</text>
      </view>
      <view class="meta">
        <text>学号 {{item.studentId}}</text>
        <text class="dot">·</text>
        <text>信誉分 {{item.creditScore}}</text>
      </view>
      <view class="actions">
        <button
          size="mini"
          class="{{item.isBanned ? 'btn-primary' : 'btn-danger'}}"
          bindtap="onToggleBan"
          data-id="{{item.id}}"
          data-banned="{{item.isBanned}}"
        >{{item.isBanned ? '解封' : '封禁'}}</button>
      </view>
    </view>

    <empty-state wx:if="{{users.length === 0 && !usersLoading}}" text="未找到匹配用户" customIcon="👤"></empty-state>
  </block>

  <view wx:if="{{(postsHasMore || reportsHasMore || feedbacksHasMore || usersHasMore)}}" class="load-more" bindtap="onLoadMore">加载更多</view>
  <view wx:if="{{(postsLoading || reportsLoading || feedbacksLoading || usersLoading)}}" class="loading-tip">加载中…</view>
</view>
