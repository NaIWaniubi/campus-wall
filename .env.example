# 服务端口
PORT=3001

# 反向代理信任层数（Express trust proxy）：
# - 默认（不设置）= 不信任任何代理：req.ip 取对端 socket 地址，客户端伪造 X-Forwarded-For 无效
# - 部署在 nginx 反代后面：必须显式设置真实跳数（单层 nginx = 1，多层按真实链路如 2）
# - 若保持不设置而前面又有反代，所有请求会共用同一 IP，限流会误伤真实用户
# 错误设置会导致 req.ip / X-Forwarded-* 头解析异常，影响限流与审计
# TRUST_PROXY=1

# 首次启动创建超级管理员的口令
# 生产环境（NODE_ENV=production）必填，缺失则拒绝启动；开发/测试默认 admin123
# ADMIN_INITIAL_PASSWORD=

# CORS 允许的 Origin 白名单（逗号分隔多个域名）。生产环境必须改为真实域名
# 默认仅放通本地 Vite 开发端口（http://localhost:5173）
# CORS_ORIGIN=http://localhost:5173

# JWT 密钥（生产环境必须修改为随机长字符串）
JWT_SECRET=campus-wall-dev-secret-key-2026

# JWT 过期时间
JWT_EXPIRES_IN=7d

# 数据库文件路径（相对路径基于项目根目录，留空使用默认 api/data.db）
# DB_PATH=./data.db

# 运行环境
NODE_ENV=development

# AI 助手（二选一：AI_* 优先，未配置时回退 OpenRouter）
# 方式 A：直连任意 OpenAI 兼容网关（KrisPhyn / DeepSeek / SiliconFlow / 本地 Ollama 等）
# AI_BASE_URL=https://api.krisphyn.cc/v1
# AI_API_KEY=
# AI_MODEL=gemini-3.8-flash
# 方式 B：OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# 微信小程序静默登录（可选：不配置时 wx.login 返回 501，小程序自动回退学号密码登录）
# WX_APPID=
# WX_SECRET=

# SQLite 在线备份：执行间隔（小时，默认 24）与保留份数（默认 7）
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=7

# 备份加密（可选：64 位 hex = 32 字节 AES-256；配置后备份落盘 .db.enc，恢复用 api/scripts/decrypt-backup.mjs）
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BACKUP_ENCRYPTION_KEY=

# Prometheus /metrics 保护（可选：配置后需请求头 x-metrics-token 才返回全量指标；
# 不配置时保持向后兼容，建议生产配置并由反代限制来源）
# METRICS_TOKEN=

# Sentry 错误上报（可选：不配置则完全关闭）
# 服务端 DSN（sentry.io 建项目选 Node.js）
# SENTRY_DSN=
# 前端 DSN（建项目选 Vue；构建期内联，改动后需重新 build）
# VITE_SENTRY_DSN=

# Web Push 离线推送（可选：三者齐备才启用；生成一对密钥：npx web-push generate-vapid-keys）
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# 微信小程序订阅消息（可选：在 mp.weixin.qq.com 订阅消息模板库添加后取模板 ID；
# 字段名需与所选模板一致，默认按 thing1 单字段假设，47003 时调整 api/utils/wx-push.ts 的 data）
# WX_APPID=
# WX_SECRET=
# WX_SUBSCRIBE_TEMPLATE_CHAT=
# WX_SUBSCRIBE_TEMPLATE_SYSTEM=
