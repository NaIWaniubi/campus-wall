.page-my-posts {
  background: #F7F2E8;
  min-height: 100vh;
}

.tab-bar {
  background: rgba(245, 246, 248, 0.96);
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid rgba(20, 17, 15, 0.05);
  gap: 10rpx;
}

.tab-item {
  flex: 1;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: #8B97A3;
  position: relative;
  letter-spacing: 0;
  font-weight: 800;
  text-align: center;
  border-radius: 999rpx;
}

.tab-item.active {
  color: #542BC4;
  background: rgba(109, 59, 245, 0.1);
  font-weight: 900;
}

.tab-item.active::after {
  display: none;
}

.post-list {
  padding: 24rpx 22rpx;
}

.post-item-wrap {
  margin-bottom: 20rpx;
}

.post-actions {
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: -12rpx;
  padding: 0 28rpx 20rpx;
}

.action-btn {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.edit-btn {
  background: rgba(109, 59, 245, 0.1);
  color: #542BC4;
}

.reject-reason {
  margin: -6rpx 24rpx 0;
  padding: 14rpx 20rpx;
  background: rgba(255, 77, 46, 0.08);
  border-left: 4rpx solid #FF4D2E;
  border-radius: 8rpx;
}

.reject-reason text {
  font-size: 24rpx;
  color: #E5484D;
  line-height: 1.5;
}

.resubmit-btn {
  background: rgba(240, 140, 0, 0.12);
  color: #F08C00;
}

.delete-btn {
  background: rgba(255, 77, 46, 0.08);
  color: #FF4D2E;
}
