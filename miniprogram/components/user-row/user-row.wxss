.user-row {
  display: flex;
  align-items: center;
  padding: 26rpx;
  margin-bottom: 18rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 28rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.05);
  box-shadow: 0 16rpx 42rpx rgba(15, 23, 42, 0.06);
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.user-row:active {
  transform: scale(0.985);
  opacity: 0.92;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.user-main {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.nickname {
  color: #14110F;
  font-size: 30rpx;
  font-weight: 800;
}

.nickname-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.credit-chip {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 28rpx;
}

.credit-chip.lv-gold { color: #B8860B; background: rgba(255, 193, 7, 0.15); }
.credit-chip.lv-good { color: #6D3BF5; background: rgba(22, 160, 133, 0.12); }
.credit-chip.lv-normal { color: #4A90D9; background: rgba(74, 144, 217, 0.12); }
.credit-chip.lv-warn { color: #E67E22; background: rgba(230, 126, 34, 0.12); }
.credit-chip.lv-bad { color: #E74C3C; background: rgba(231, 76, 60, 0.12); }

.signature {
  margin-top: 6rpx;
  color: #6E6659;
  font-size: 24rpx;
}
