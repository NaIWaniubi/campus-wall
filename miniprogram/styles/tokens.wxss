/* tokens.wxss —— 全局设计变量（方向 B 复用 2026-07-31 spec）
 * 用法：page 作用域变量 + var(--xxx) 引用。
 * 注意：WXSS 中 var() 不可 fallback 时回退到原 hex，规避老基础库兼容风险。
 */

page {
  /* 颜色：中性 */
  --color-bg: #FFFFFF;
  --color-bg-soft: #FBF7EE;
  --color-bg-muted: #EFE8DA;
  --color-bg-elevated: #ffffff;
  --color-bg-page: #F7F2E8;
  --color-bg-overlay: rgba(0, 0, 0, 0.45);
  --color-divider: #DED3BF;
  --color-text-primary: #14110F;
  --color-text-secondary: #4A443C;
  --color-text-tertiary: #6E6659;
  --color-text-placeholder: #A79E8D;
  --color-text-inverse: #ffffff;

  /* 颜色：V4 纸感海报体系（紫为品牌，绿白旧皮肤已废弃） */
  --color-brand: #6D3BF5;
  --color-brand-soft: #8B5CF6;
  --color-brand-strong: #542BC4;
  --color-brand-tint: rgba(109, 59, 245, 0.08);
  --color-ink: #14110F;
  --color-paper: #F7F2E8;
  --color-lime: #C8F04A;
  --color-coral: #FF4D2E;
  --color-sky: #38D6F5;
  --color-violet: #6D3BF5;
  --color-accent: #FF4D2E;
  --color-warning: #B45309;
  --color-danger: #FF4D2E;
  --color-success: #0E7C86;
  --color-info: #38D6F5;

  /* 间距（4 倍数） */
  --space-1: 4rpx;
  --space-2: 8rpx;
  --space-3: 12rpx;
  --space-4: 16rpx;
  --space-5: 20rpx;
  --space-6: 24rpx;
  --space-8: 32rpx;
  --space-10: 40rpx;
  --space-12: 48rpx;
  --space-16: 64rpx;

  /* 圆角 */
  --radius-xs: 4rpx;
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 24rpx;
  --radius-xl: 36rpx;
  --radius-pill: 999rpx;

  /* 字号 */
  --font-size-caption: 22rpx;
  --font-size-body-s: 26rpx;
  --font-size-body: 28rpx;
  --font-size-body-l: 30rpx;
  --font-size-title-s: 32rpx;
  --font-size-title: 36rpx;
  --font-size-title-l: 40rpx;
  --font-size-display: 48rpx;

  /* 字重 */
  --font-weight-regular: 400;
  --font-weight-medium: 500;
  --font-weight-semibold: 600;
  --font-weight-bold: 700;
  --font-weight-extra: 800;
  --font-weight-black: 900;

  /* 行高 */
  --line-height-tight: 1.3;
  --line-height-normal: 1.5;
  --line-height-relaxed: 1.7;

  /* 阴影 */
  --shadow-sm: 4rpx 4rpx 0 #14110F;
  --shadow-md: 6rpx 6rpx 0 #14110F;
  --shadow-lg: 12rpx 12rpx 0 #14110F;

  /* 动效 */
  --ease-standard: cubic-bezier(0.4, 0, 0.2, 1);
  --ease-emphasized: cubic-bezier(0.2, 0, 0, 1);
  --duration-fast: 150ms;
  --duration-base: 250ms;
  --duration-slow: 400ms;

  /* 布局 */
  --tabbar-height: 100rpx;
  --navbar-height: 88rpx;
  --safe-bottom: env(safe-area-inset-bottom);
}
