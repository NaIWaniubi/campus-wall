.tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  height: 104rpx;
  padding: 10rpx 14rpx 12rpx;
  background: linear-gradient(112deg, #16323F 0%, #27334A 34%, #573D69 67%, #71384B 100%);
  border-top: 1rpx solid rgba(255, 255, 255, 0.16);
  box-shadow: 0 -12rpx 34rpx rgba(25, 31, 44, 0.2);
  box-sizing: content-box;
}

.tabbar::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 2rpx;
  background: linear-gradient(90deg, #2CC9DD, #9A7BE7, #F27886, #F5C860, #2CC9DD);
  background-size: 180% 100%;
  animation: navShimmer 5s linear infinite;
}

.tab-item {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  color: rgba(255, 255, 255, 0.72);
}

.tab-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 16rpx;
}

.tab-icon { width: 38rpx; height: 38rpx; }

.tab-label {
  margin-top: 4rpx;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.2;
}

.is-active { color: #FFFFFF; font-weight: 800; }
.is-active .tab-icon-wrap { background: #2CC9DD; box-shadow: 0 8rpx 18rpx rgba(44, 201, 221, .24); }
.tab-item:nth-child(1).is-active .tab-icon-wrap { background: #2CC9DD; }
.tab-item:nth-child(2).is-active .tab-icon-wrap { background: #9A7BE7; box-shadow: 0 8rpx 18rpx rgba(154, 123, 231, .26); }
.tab-item:nth-child(4).is-active .tab-icon-wrap { background: #F27886; box-shadow: 0 8rpx 18rpx rgba(242, 120, 134, .26); }
.tab-item:nth-child(5).is-active .tab-icon-wrap { background: #F5C860; box-shadow: 0 8rpx 18rpx rgba(245, 200, 96, .26); }

.tab-publish { transform: translateY(-20rpx); }
.tab-publish .tab-icon-wrap {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #F27886;
  box-shadow: 0 12rpx 26rpx rgba(242, 120, 134, 0.32);
  animation: publishPulse 2.8s ease-in-out infinite;
}
.tab-publish .tab-icon { width: 42rpx; height: 42rpx; }
.tab-publish .tab-label { margin-top: 6rpx; color: #FFFFFF; }
.tab-publish.is-active .tab-icon-wrap { background: #F27886; }

@keyframes navShimmer { to { background-position: -180% 0; } }
@keyframes publishPulse { 0%, 100% { transform: translateY(0); box-shadow: 0 12rpx 26rpx rgba(242, 120, 134, .32); } 50% { transform: translateY(-4rpx); box-shadow: 0 17rpx 31rpx rgba(154, 123, 231, .3); } }
