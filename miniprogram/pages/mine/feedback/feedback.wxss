.page-feedback {
  background: #F7F2E8;
  min-height: 100vh;
  padding-bottom: 172rpx;
}

.feedback-form {
  padding: 24rpx;
}

.form-item {
  padding: 30rpx;
  margin-bottom: 18rpx;
}

.label {
  font-size: 28rpx;
  font-weight: 900;
  color: #14110F;
  margin-bottom: 20rpx;
  display: block;
  letter-spacing: 0;
}

.type-picker {
  padding: 20rpx 0;
  font-size: 28rpx;
  letter-spacing: 0;
}

.content-field {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  line-height: 1.8;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #F7F2E8;
  letter-spacing: 0;
}

.char-count {
  font-size: 22rpx;
  text-align: right;
  margin-top: 8rpx;
  letter-spacing: 0;
}

.form-item input {
  font-size: 28rpx;
  min-height: 72rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  background: #F7F2E8;
  letter-spacing: 0;
}

.image-list {
  gap: 12rpx;
  margin-top: 16rpx;
}

.image-item {
  position: relative;
  width: calc((100% - 24rpx) / 3);
  height: 180rpx;
  border-radius: 18rpx;
  overflow: hidden;
}

.image-item image {
  width: 100%;
  height: 100%;
}

.image-delete {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(23, 32, 42, 0.58);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  border-radius: 50%;
}

.image-add {
  width: calc((100% - 24rpx) / 3);
  height: 180rpx;
  border: 2rpx dashed rgba(109, 59, 245, 0.2);
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(109, 59, 245, 0.035);
}

.add-icon {
  font-size: 52rpx;
  color: #6D3BF5;
  line-height: 1;
}

.submit-bar {
  position: fixed;
  bottom: 18rpx;
  left: 18rpx;
  right: 18rpx;
  padding: 18rpx;
  background: #FFFFFF;
  box-shadow: 6rpx 6rpx 0 rgba(20, 17, 15, 0.14);
  border: 1rpx solid rgba(20, 17, 15, 0.06);
  border-radius: 34rpx;
  z-index: 100;
}

.submit-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 32rpx;
  letter-spacing: 2rpx;
  border-radius: 28rpx;
}

.submit-btn[disabled] {
  background: #D7DEE2;
  color: rgba(255, 255, 255, 0.72);
  box-shadow: none;
}
