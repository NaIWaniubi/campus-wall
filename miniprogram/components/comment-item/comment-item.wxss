.comment-item {
  padding: 26rpx 0;
  border-bottom: 1rpx solid rgba(20, 17, 15, 0.06);
  animation: fadeIn 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-main {
  align-items: flex-start;
}

.comment-body {
  margin-left: 16rpx;
}

.comment-header {
  margin-bottom: 10rpx;
}

.comment-author {
  font-size: 27rpx;
  font-weight: 800;
  color: #14110F;
  letter-spacing: 0;
}

.comment-time {
  font-size: 22rpx;
  color: #6E6659;
}

.comment-content {
  font-size: 29rpx;
  color: #14110F;
  line-height: 1.72;
  margin-bottom: 16rpx;
  word-break: break-all;
  letter-spacing: 0;
}

.comment-actions {
  gap: 28rpx;
}

.comment-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #F7F2E8;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.comment-action:active {
  transform: scale(0.94);
  opacity: 0.86;
}

.action-icon {
  width: 30rpx;
  height: 30rpx;
}

.action-icon-small {
  width: 24rpx;
  height: 24rpx;
}

.comment-action text {
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0;
}

.replies {
  background: #F7F2E8;
  border-radius: 22rpx;
  padding: 18rpx 20rpx;
  margin-top: 16rpx;
  border: 1rpx solid rgba(20, 17, 15, 0.04);
}

.reply-item {
  padding: 14rpx 0;
}

.reply-item:not(:last-child) {
  border-bottom: 1rpx solid rgba(20, 17, 15, 0.05);
}

.reply-main {
  align-items: flex-start;
}

.reply-avatar {
  width: 48rpx;
  height: 48rpx;
}

.reply-body {
  margin-left: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  letter-spacing: 0;
}

.reply-author {
  color: #542BC4;
  font-weight: 800;
}

.reply-text {
  color: #14110F;
}

.reply-to {
  color: #542BC4;
  font-weight: 800;
}

.reply-actions {
  margin-top: 8rpx;
  margin-left: 60rpx;
  gap: 24rpx;
  align-items: center;
}

.reply-time {
  font-size: 20rpx;
}

.reply-action {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.reply-action text {
  font-size: 20rpx;
  letter-spacing: 0;
}
