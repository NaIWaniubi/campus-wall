.follows-page {
  min-height: 100vh;
  padding: 24rpx;
  background: #F5F6F8;
}

.follow-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.follow-tab {
  padding: 12rpx 36rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  color: #7B8794;
  font-size: 27rpx;
  font-weight: 700;
}

.follow-tab.active {
  background: rgba(22, 160, 133, 0.12);
  border-color: rgba(22, 160, 133, 0.35);
  color: #0E7C67;
}

.list-end,
.list-loading {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
}

.user-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 28rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.05);
  box-shadow: 0 16rpx 42rpx rgba(15, 23, 42, 0.06);
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.user-main {
  display: flex;
  flex-direction: column;
}

.nickname {
  color: #17202A;
  font-size: 30rpx;
  font-weight: 800;
}

.signature {
  margin-top: 6rpx;
  color: #7B8794;
  font-size: 24rpx;
}
