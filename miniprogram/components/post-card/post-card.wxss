/* post-card.wxss —— 小红书风卡片（spec-B T4，按现有数据契约适配）
 * 结构：封面（cover + 板块/已售浮层徽章）→ 标题两行 → 正文两行 → 业务标签 → 九宫格 → 作者行 + 操作行
 * perf-low：禁用 transform/shadow 动画（app.js 低端机注入 globalData.perfLow）
 */

.post-card {
  background: var(--color-bg-elevated, #ffffff);
  border-radius: var(--radius-xl, 22rpx);
  overflow: hidden;
  margin: var(--space-3, 16rpx) var(--space-4, 18rpx);
  box-shadow: var(--shadow-sm, 0 4rpx 20rpx rgba(15, 23, 42, 0.05));
  transition: transform var(--duration-fast, 0.15s) var(--ease-standard, ease-out),
              box-shadow var(--duration-fast, 0.15s) var(--ease-standard, ease-out);
}
.post-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-md, 0 12rpx 30rpx rgba(15, 23, 42, 0.09));
}
.post-card--perf-low {
  transition: none !important;
}
.post-card--perf-low:active {
  transform: none;
}

/* ---------- 封面 ---------- */
.pc-cover {
  position: relative;
  width: 100%;
  height: 420rpx;
  background: var(--color-bg-muted, #EFE8DA);
}
.pc-cover-img {
  width: 100%;
  height: 100%;
  display: block;
}
.pc-cover-badges {
  position: absolute;
  top: var(--space-3, 16rpx);
  left: var(--space-3, 16rpx);
  display: flex;
  gap: var(--space-2, 12rpx);
}
.pc-badge {
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  border-radius: 999rpx;
  opacity: 0.92;
}
.pc-badge--sold {
  background: rgba(23, 32, 42, 0.72);
  color: #fff;
}

/* ---------- 正文区 ---------- */
.pc-body {
  padding: var(--space-4, 18rpx) var(--space-4, 18rpx) var(--space-3, 16rpx);
}
.pc-category-inline {
  display: inline-block;
  padding: 4rpx 14rpx;
  font-size: 22rpx;
  border-radius: 999rpx;
  margin-bottom: var(--space-2, 12rpx);
}
.pc-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary, #14110F);
  line-height: 1.35;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.pc-summary {
  margin-top: var(--space-1, 8rpx);
  font-size: 26rpx;
  color: var(--color-text-secondary, #4A443C);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 业务标签行（二手/失物等差异化字段） */
.pc-extras {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-2, 12rpx);
  margin-top: var(--space-2, 12rpx);
}
.pc-price {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-accent, #FF4D2E);
}
.pc-tag {
  font-size: 22rpx;
  color: var(--color-text-tertiary, #6E6659);
  background: var(--color-bg-muted, #EFE8DA);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}
.pc-tag--warn {
  color: var(--color-warning, #F59E0B);
  background: rgba(245, 158, 11, 0.12);
}

/* 多图九宫格 */
.pc-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: var(--space-3, 16rpx);
}
.pc-grid-item {
  width: calc((100% - 16rpx) / 3);
  height: 210rpx;
  border-radius: var(--radius-md, 12rpx);
  overflow: hidden;
  background: var(--color-bg-muted, #EFE8DA);
}
.pc-grid-item image {
  width: 100%;
  height: 100%;
  display: block;
}

.pc-location {
  margin-top: var(--space-2, 12rpx);
  font-size: 22rpx;
  color: var(--color-text-tertiary, #6E6659);
}

/* ---------- 底部：作者 + 操作 ---------- */
.pc-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--space-3, 16rpx);
  padding-top: var(--space-3, 16rpx);
  border-top: 1rpx solid var(--color-divider, #DED3BF);
}
.pc-author {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}
.pc-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--color-bg-muted, #EFE8DA);
}
.pc-author-name {
  font-size: 24rpx;
  color: var(--color-text-secondary, #4A443C);
  max-width: 180rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.pc-credit {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}
.pc-credit--gold { color: #B45309; background: rgba(245, 158, 11, 0.15); }
.pc-credit--blue { color: #1D4ED8; background: rgba(59, 130, 246, 0.12); }
.pc-credit--orange { color: #C2410C; background: rgba(249, 115, 22, 0.12); }
.pc-credit--gray { color: var(--color-text-tertiary, #6E6659); background: var(--color-bg-muted, #EFE8DA); }
.pc-dot, .pc-time {
  font-size: 22rpx;
  color: var(--color-text-placeholder, #c9cdd4);
  flex-shrink: 0;
}

.pc-actions {
  display: flex;
  align-items: center;
  gap: var(--space-4, 18rpx);
  flex-shrink: 0;
}
.pc-action {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: var(--color-text-tertiary, #6E6659);
  padding: 4rpx 0;
}
.pc-action-symbol {
  font-size: 28rpx;
  line-height: 1;
}
.pc-action--liked {
  color: var(--color-accent, #FF4D2E);
}
.pc-action--fav {
  color: var(--color-warning, #F59E0B);
}
.pc-share {
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: inherit;
}
.pc-share::after {
  border: none;
}
