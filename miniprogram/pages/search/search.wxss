.page-search {
  background: #F5F6F8;
  min-height: 100vh;
}

.search-header {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  background: rgba(245, 246, 248, 0.96);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  gap: 16rpx;
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.05);
}

.search-input-wrap {
  flex: 1;
  align-items: center;
  background: #FFFFFF;
  border-radius: 999rpx;
  padding: 14rpx 28rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.04);
}

.search-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #17202A;
  letter-spacing: 0;
}

.clear-btn {
  font-size: 28rpx;
  color: #98A3AE;
  padding: 8rpx;
}

.cancel-btn {
  font-size: 28rpx;
  color: #16A085;
  flex-shrink: 0;
  font-weight: 800;
  letter-spacing: 0;
}

.search-content {
  padding: 28rpx;
}

.section-header {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #17202A;
  letter-spacing: 0;
}

.clear-history {
  font-size: 26rpx;
  color: #98A3AE;
  letter-spacing: 0.5rpx;
}

.hot-list {
  background: rgba(255, 255, 255, 0.96);
  border-radius: 30rpx;
  padding: 0 28rpx;
  margin-bottom: 36rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.05);
  box-shadow: 0 18rpx 48rpx rgba(15, 23, 42, 0.06);
}

.hot-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.05);
  align-items: center;
}

.hot-item:last-child {
  border-bottom: none;
}

.hot-index {
  width: 48rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #98A3AE;
  text-align: center;
  letter-spacing: 0;
}

.hot-index.top {
  color: #FF6B6B;
}

.hot-name {
  flex: 1;
  font-size: 28rpx;
  color: #26323D;
  margin-left: 12rpx;
  letter-spacing: 0;
}

.hot-count {
  font-size: 24rpx;
  letter-spacing: 0;
}

.history-list {
  gap: 12rpx;
}

.history-tag {
  padding: 12rpx 28rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #65717D;
  border: 1rpx solid rgba(15, 23, 42, 0.05);
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.035);
  letter-spacing: 0;
}

.search-results {
  padding: 0;
}

.filter-tabs {
  padding: 20rpx 28rpx;
  background: rgba(245, 246, 248, 0.96);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  gap: 10rpx;
  overflow-x: auto;
  white-space: nowrap;
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.05);
}

.filter-tab {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #636E72;
  background: #FFFFFF;
  flex-shrink: 0;
  border: 1rpx solid rgba(15, 23, 42, 0.05);
  letter-spacing: 0;
  font-weight: 700;
}

.filter-tab.active {
  background: rgba(22, 160, 133, 0.1);
  color: #0E7C67;
  border-color: rgba(22, 160, 133, 0.16);
  font-weight: 900;
}

.result-list {
  padding: 24rpx;
}
