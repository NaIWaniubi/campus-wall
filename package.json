{
  "name": "campus-wall",
  "private": true,
  "version": "1.0.0",
  "description": "校园墙 - 面向本校学生的校园信息聚合社区平台",
  "type": "module",
  "scripts": {
    "client:dev": "vite",
    "server:dev": "nodemon",
    "dev": "concurrently \"npm run client:dev\" \"npm run server:dev\"",
    "build": "vue-tsc -b && vite build",
    "start": "cross-env NODE_ENV=production tsx api/server.ts",
    "start:pm2": "pm2 start ecosystem.config.cjs",
    "preview": "vite preview",
    "seed": "tsx api/seed-demo.ts",
    "test": "vitest --run",
    "test:watch": "vitest",
    "pretest": "node scripts/ensure-vitest-shim.mjs",
    "check": "vue-tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@lucide/vue": "^1.0.0",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dompurify": "^3.4.14",
    "dotenv": "^17.2.1",
    "echarts": "^5.6.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.29.5",
    "marked": "^18.0.10",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.2.0",
    "sharp": "^0.35.3",
    "vue": "^3.5.41",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.6.4",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "@vercel/node": "^5.3.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/runtime-dom": "^3.4.15",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.11.10",
    "nodemon": "^3.1.10",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.3",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.46.4",
    "unplugin-vue-dev-locator": "^1.0.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
