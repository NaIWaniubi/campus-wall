.page-sub-category {
  background: #F7F2E8;
  min-height: 100vh;
  padding-bottom: 140rpx;
}

.tab-bar {
  background: rgba(245, 246, 248, 0.96);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.05);
  gap: 10rpx;
}

.tab-item {
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  color: #8B97A3;
  position: relative;
  letter-spacing: 0;
  font-weight: 800;
  border-radius: 999rpx;
}

.tab-item.active {
  color: #542BC4;
  background: rgba(22, 160, 133, 0.1);
  font-weight: 900;
}

.tab-item.active::after {
  display: none;
}

.post-list {
  padding: 24rpx 22rpx;
}

.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6D3BF5, #8B5CF6);
  box-shadow: 0 18rpx 44rpx rgba(22, 160, 133, 0.32), 0 6rpx 16rpx rgba(15, 23, 42, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}

.fab-icon {
  font-size: 56rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}

.cat-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 26rpx;
  margin-bottom: 20rpx;
}

.cat-head-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #14110F;
}
