.page-sub-category {
  background: #F7F2E8;
  min-height: 100vh;
  padding-bottom: 140rpx;
}

.filter-bar {
  display: flex;
  padding: 20rpx 28rpx;
  gap: 16rpx;
  border-radius: 0 0 28rpx 28rpx;
  margin-bottom: 0;
}

.filter-item {
  flex: 1;
}

.filter-picker {
  padding: 14rpx 20rpx;
  background: #F7F2E8;
  border-radius: 999rpx;
  font-size: 26rpx;
  letter-spacing: 0;
  border: 1rpx solid rgba(20, 17, 15, 0.05);
}

.tab-bar {
  background: rgba(245, 246, 248, 0.96);
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid rgba(20, 17, 15, 0.05);
  gap: 10rpx;
}

.tab-item {
  flex: 1;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  color: #8B97A3;
  position: relative;
  letter-spacing: 0;
  font-weight: 800;
  text-align: center;
  border-radius: 999rpx;
}

.tab-item.active {
  color: #542BC4;
  background: rgba(109, 59, 245, 0.1);
  font-weight: 900;
}

.tab-item.active::after {
  display: none;
}

.post-list {
  padding: 24rpx 22rpx;
}

.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #6D3BF5;
  box-shadow: 6rpx 6rpx 0 #14110F;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}

.fab-icon {
  font-size: 56rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}

.cat-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 26rpx;
  margin-bottom: 20rpx;
}

.cat-head-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #14110F;
}
