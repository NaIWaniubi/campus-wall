.chat-page {
  min-height: 100vh;
  background: #F7F2E8;
}

.message-list {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 会话态：消息区 + 底部输入栏 */
.message-scroll {
  height: calc(100vh - 200rpx);
  padding: 26rpx 24rpx;
  box-sizing: border-box;
}

.chat-loading {
  text-align: center;
  color: #8A97A3;
  font-size: 26rpx;
  padding: 40rpx 0;
}

.msg-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.msg-row.mine {
  flex-direction: row-reverse;
}

.msg-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #FFFFFF;
  flex-shrink: 0;
}

.msg-main {
  max-width: 72%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.msg-main.mine {
  align-items: flex-end;
}

.msg-name {
  font-size: 22rpx;
  color: #8A97A3;
  margin-bottom: 6rpx;
  margin-left: 8rpx;
}

.msg-failed {
  font-size: 20rpx;
  color: #E5484D;
  margin-top: 6rpx;
}

.bubble {
  max-width: 100%;
  padding: 20rpx 24rpx;
  margin-bottom: 18rpx;
  border-radius: 28rpx 28rpx 28rpx 8rpx;
  background: #FFFFFF;
  color: #14110F;
  font-size: 28rpx;
  line-height: 1.6;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.05);
  animation: fadeInUp 0.28s ease;
  word-break: break-all;
}

.bubble.mine {
  margin-left: auto;
  background: linear-gradient(135deg, #6D3BF5, #8B5CF6);
  color: #FFFFFF;
  border-radius: 28rpx 28rpx 8rpx 28rpx;
  box-shadow: 0 14rpx 30rpx rgba(22, 160, 133, 0.18);
}

.bubble.pending {
  opacity: 0.6;
}

.bubble.failed {
  opacity: 0.75;
  border: 1rpx solid rgba(229, 72, 77, 0.55);
}

.input-bar {
  position: fixed;
  left: 18rpx;
  right: 18rpx;
  bottom: 18rpx;
  display: flex;
  gap: 16rpx;
  padding: 18rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(26rpx);
  -webkit-backdrop-filter: blur(26rpx);
  border-radius: 34rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 18rpx 48rpx rgba(15, 23, 42, 0.12);
}

.chat-input {
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #F7F2E8;
  font-size: 28rpx;
}

.send-btn {
  width: 132rpx;
  height: 76rpx;
  margin: 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #6D3BF5, #8B5CF6);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 76rpx;
}

.send-btn[disabled] {
  background: #D7DEE2;
  color: rgba(255, 255, 255, 0.72);
  box-shadow: none;
}
