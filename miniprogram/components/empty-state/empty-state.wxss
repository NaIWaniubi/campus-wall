.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx var(--space-12, 60rpx);
}

.empty-state--animated {
  animation: fadeInUp 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.empty-state--small {
  padding: 80rpx 40rpx;
}

.empty-state--small .empty-state__image {
  width: 160rpx;
  height: 160rpx;
}

.empty-state--small .empty-state__icon-text {
  font-size: 80rpx;
}

.empty-state--small .empty-state__text {
  font-size: 26rpx;
}

.empty-state--small .empty-state__sub-text {
  font-size: 22rpx;
}

.empty-state__icon-wrap {
  margin-bottom: 28rpx;
  animation: float 4s ease-in-out infinite;
}

.empty-state__image {
  width: 240rpx;
  height: 240rpx;
  opacity: 0.72;
}

.empty-state__icon-text {
  font-size: 120rpx;
  display: block;
  text-align: center;
  filter: grayscale(0.15);
}

.empty-state__text {
  color: #6E6659;
  font-size: var(--font-size-body, 28rpx);
  margin-bottom: var(--space-3, 12rpx);
  font-weight: var(--font-weight-bold, 700);
  letter-spacing: 0;
  text-align: center;
  line-height: 1.6;
}

.empty-state__sub-text {
  color: #6E6659;
  font-size: 24rpx;
  margin-bottom: 36rpx;
  letter-spacing: 0;
  text-align: center;
  line-height: 1.5;
  max-width: 480rpx;
}

.empty-state__btn {
  background: var(--color-brand, #6D3BF5);
  color: var(--color-text-inverse, #fff);
  border-radius: var(--radius-pill, 999rpx);
  padding: 18rpx 52rpx;
  font-size: var(--font-size-body, 28rpx);
  font-weight: var(--font-weight-extra, 800);
  letter-spacing: 0;
  box-shadow: 4rpx 4rpx 0 rgba(20, 17, 15, 0.12);
  margin-top: var(--space-3, 12rpx);
  transition: all 0.25s ease;
}

.empty-state__btn--outline {
  background: rgba(109, 59, 245, 0.06);
  color: #6D3BF5;
  border: 1rpx solid rgba(109, 59, 245, 0.24);
  box-shadow: none;
  margin-top: 16rpx;
}

.empty-state__btn--outline.empty-state__btn--hover {
  background: rgba(109, 59, 245, 0.08);
  border-color: #6D3BF5;
}

.empty-state__btn--hover {
  opacity: 0.85;
  transform: scale(0.97);
  box-shadow: 4rpx 4rpx 0 rgba(20, 17, 15, 0.12);
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-12rpx);
  }
}
