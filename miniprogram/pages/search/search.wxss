.page-search {
  background: #F7F2E8;
  min-height: 100vh;
}

.search-header {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  background: rgba(245, 246, 248, 0.96);
  gap: 16rpx;
  border-bottom: 1rpx solid rgba(20, 17, 15, 0.05);
}

.search-input-wrap {
  flex: 1;
  align-items: center;
  background: #FFFFFF;
  border-radius: 999rpx;
  padding: 14rpx 28rpx;
  border: 1rpx solid rgba(20, 17, 15, 0.06);
  box-shadow: 4rpx 4rpx 0 rgba(20, 17, 15, 0.12);
}

.search-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #14110F;
  letter-spacing: 0;
}

.clear-btn {
  font-size: 28rpx;
  color: #6E6659;
  padding: 8rpx;
}

.cancel-btn {
  font-size: 28rpx;
  color: #6D3BF5;
  flex-shrink: 0;
  font-weight: 800;
  letter-spacing: 0;
}

.search-content {
  padding: 28rpx;
}

.section-header {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #14110F;
  letter-spacing: 0;
  border-left: 8rpx solid #C8F04A;
  padding-left: 14rpx;
}

.clear-history {
  font-size: 26rpx;
  color: #6E6659;
  letter-spacing: 0.5rpx;
}

.hot-list {
  background: #FFFFFF;
  border-radius: 30rpx;
  padding: 0 28rpx;
  margin-bottom: 36rpx;
  border: 1rpx solid rgba(20, 17, 15, 0.05);
  box-shadow: 6rpx 6rpx 0 rgba(20, 17, 15, 0.14);
}

.hot-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(20, 17, 15, 0.05);
  align-items: center;
}

.hot-item:last-child {
  border-bottom: none;
}

.hot-index {
  width: 48rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #6E6659;
  text-align: center;
  letter-spacing: 0;
}

.hot-index.top {
  color: #FF4D2E;
}

.hot-name {
  flex: 1;
  font-size: 28rpx;
  color: #14110F;
  margin-left: 12rpx;
  letter-spacing: 0;
}

.hot-count {
  font-size: 24rpx;
  letter-spacing: 0;
}

.history-list {
  gap: 12rpx;
}

.history-tag {
  padding: 12rpx 28rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #4A443C;
  border: 1rpx solid rgba(20, 17, 15, 0.05);
  box-shadow: 4rpx 4rpx 0 rgba(20, 17, 15, 0.12);
  letter-spacing: 0;
}

.search-results {
  padding: 0;
}

.filter-tabs {
  padding: 20rpx 28rpx;
  background: rgba(245, 246, 248, 0.96);
  gap: 10rpx;
  overflow-x: auto;
  white-space: nowrap;
  border-bottom: 1rpx solid rgba(20, 17, 15, 0.05);
}

.filter-tab {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #636E72;
  background: #FFFFFF;
  flex-shrink: 0;
  border: 1rpx solid rgba(20, 17, 15, 0.05);
  letter-spacing: 0;
  font-weight: 700;
}

.filter-tab.active {
  background: rgba(109, 59, 245, 0.1);
  color: #542BC4;
  border-color: rgba(109, 59, 245, 0.16);
  font-weight: 900;
}

.result-list {
  padding: 24rpx;
}
