.page-index { min-height: 100vh; padding-bottom: 184rpx; background: var(--color-bg-page, #F7F2E8); }

.color-ribbon { display: flex; height: 6rpx; overflow: hidden; }
.color-ribbon view { flex: 1; }
.ribbon-cyan { background: #2CC9DD; }.ribbon-violet { background: #9A7BE7; }.ribbon-coral { background: #F27886; }.ribbon-yellow { background: #F5C860; }

.header { position: sticky; top: 0; z-index: 100; padding: 20rpx 24rpx 0; background: var(--color-bg, #ffffff); border-bottom: 1rpx solid var(--color-divider, #DED3BF); }
.brand-row { display: flex; align-items: center; justify-content: space-between; }
.brand-line { display: flex; align-items: center; }
.brand-title { font-size: 40rpx; font-weight: var(--font-weight-black, 900); line-height: 1.18; color: var(--color-text-primary, #18212D); }
.brand-spark { display: grid; place-items: center; width: 28rpx; height: 28rpx; margin-left: 8rpx; border-radius: 8rpx; color: #fff; background: var(--color-brand, #6D3BF5); font-size: 16rpx; }
.brand-subtitle { display: block; margin-top: 4rpx; color: var(--color-text-tertiary, #7D8998); font-size: 22rpx; font-weight: var(--font-weight-medium, 500); }
.campus-signal { display: flex; align-items: center; gap: 6rpx; padding: 8rpx 16rpx; border: 1rpx solid var(--color-divider, #DED3BF); border-radius: var(--radius-pill, 999rpx); color: var(--color-text-primary, #354252); background: var(--color-bg, #fff); font-size: 22rpx; font-weight: var(--font-weight-semibold, 600); box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(20, 17, 15, 0.04)); }
.signal-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--color-info, #2CC9DD); box-shadow: 0 0 0 4rpx rgba(56, 214, 245, 0.25); }

.campus-canvas { position: relative; height: 0; margin-top: 0; overflow: hidden; border-radius: 0; background: transparent; box-shadow: none; padding: 0; }
.canvas-band, .canvas-cyan, .canvas-violet, .canvas-coral, .canvas-yellow, .canvas-content, .canvas-meter { display: none; }

.header-tools { display: flex; align-items: center; gap: 12rpx; margin: 18rpx 0 14rpx; }
.search-bar { flex: 1; display: flex; align-items: center; min-width: 0; height: 68rpx; padding: 0 22rpx; border: 1rpx solid var(--color-divider, #DED3BF); border-radius: var(--radius-pill, 999rpx); color: var(--color-text-tertiary, #8B97A5); background: var(--color-bg-soft, #fafafa); font-size: 24rpx; }
.search-bar:active { opacity: 0.85; }
.search-symbol { margin-right: 12rpx; color: var(--color-text-secondary, #243242); font-size: 30rpx; line-height: 1; }
.daily-pulse { display: grid; place-items: center; width: 64rpx; height: 64rpx; border-radius: 50%; color: #fff; background: var(--color-brand, #6D3BF5); font-size: 18rpx; font-weight: var(--font-weight-bold, 700); letter-spacing: 1rpx; box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(109, 59, 245, 0.18)); }

.topic-rail { white-space: nowrap; margin: 0 -24rpx 6rpx; padding: 4rpx 24rpx; }
.topic-item { display: inline-flex; align-items: center; gap: 6rpx; padding: 10rpx 20rpx; margin-right: 12rpx; border-radius: var(--radius-pill, 999rpx); color: var(--color-text-secondary, #4A443C); font-size: 24rpx; font-weight: var(--font-weight-medium, 500); background: var(--color-bg-soft, #EFE8DA); transition: background .2s ease, color .2s ease; }
.topic-item.active { color: var(--color-text-inverse, #ffffff); background: var(--color-text-primary, #18212D); font-weight: var(--font-weight-semibold, 600); }
.topic-orbit { display: none; }
.all-orbit { display: none; }
.topic-item.active .topic-orbit { display: none; }

.sort-tabs { display: flex; align-items: flex-end; height: 60rpx; gap: 28rpx; padding-bottom: 4rpx; }
.sort-tab { position: relative; padding: 0 2rpx 12rpx; color: var(--color-text-tertiary, #8C96A3); font-size: 26rpx; font-weight: var(--font-weight-bold, 700); }
.sort-tab.active { color: var(--color-text-primary, #18212D); font-weight: var(--font-weight-black, 900); }
.active-mark { position: absolute; right: 2rpx; bottom: 4rpx; left: 2rpx; height: 4rpx; border-radius: 6rpx; background: var(--color-brand, #6D3BF5); }

.post-list { padding: 18rpx 22rpx 30rpx; }

.page-index.perf-low .color-ribbon view,
.page-index.perf-low .brand-spark,
.page-index.perf-low .signal-dot,
.page-index.perf-low .active-mark { animation: none !important; }

@keyframes ribbonFlow { 0%,100% { opacity: .82; transform: scaleX(1); } 50% { opacity: 1; transform: scaleX(.92); } }

/* ── V4 海报头覆盖（页面级，加载于 app.wxss 之后）──────────────── */
.page-index .header {
  background: var(--color-ink, #14110F);
  border-bottom: 0;
  padding-bottom: 24rpx;
}
.page-index .brand-title { color: #F7F2E8; }
.page-index .brand-spark { background: var(--color-lime, #C8F04A); color: #14110F; border-radius: 10rpx; }
.page-index .brand-subtitle { color: rgba(247, 242, 232, 0.55); }
.page-index .campus-signal {
  background: rgba(255, 255, 255, 0.08);
  color: #F7F2E8;
  border-color: rgba(247, 242, 232, 0.28);
  box-shadow: none;
}
.page-index .signal-dot { background: var(--color-lime, #C8F04A); }
.page-index .search-bar {
  background: rgba(255, 255, 255, 0.07);
  border: 1rpx solid rgba(247, 242, 232, 0.26);
  color: rgba(247, 242, 232, 0.5);
}
.page-index .search-symbol { color: rgba(247, 242, 232, 0.6); }
.page-index .daily-pulse { background: var(--color-lime, #C8F04A); color: #14110F; box-shadow: none; }
.page-index .topic-item {
  background: rgba(255, 255, 255, 0.07);
  color: rgba(247, 242, 232, 0.72);
  border: 1rpx solid rgba(247, 242, 232, 0.2);
  border-radius: 999rpx;
}
.page-index .topic-item.active { background: var(--color-lime, #C8F04A); color: #14110F; font-weight: 800; }
.page-index .topic-orbit { border-color: rgba(247, 242, 232, 0.32) !important; color: #F7F2E8 !important; background: transparent !important; }
.page-index .topic-item.active .topic-orbit { border-color: #14110F !important; color: #14110F !important; }
.page-index .sort-tab { color: rgba(247, 242, 232, 0.45); }
.page-index .sort-tab.active { color: #F7F2E8; }
.page-index .active-mark { background: var(--color-lime, #C8F04A); }
