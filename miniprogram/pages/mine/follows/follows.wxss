.follows-page {
  min-height: 100vh;
  padding: 24rpx;
  background: #F7F2E8;
}

.follow-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.follow-tab {
  padding: 12rpx 36rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(20, 17, 15, 0.08);
  color: #6E6659;
  font-size: 27rpx;
  font-weight: 700;
}

.follow-tab.active {
  background: rgba(109, 59, 245, 0.12);
  border-color: rgba(109, 59, 245, 0.35);
  color: #542BC4;
}

.list-end,
.list-loading {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
}

.user-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  border: 1rpx solid rgba(20, 17, 15, 0.05);
  box-shadow: 6rpx 6rpx 0 rgba(20, 17, 15, 0.14);
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.user-main {
  display: flex;
  flex-direction: column;
}

.nickname {
  color: #14110F;
  font-size: 30rpx;
  font-weight: 800;
}

.signature {
  margin-top: 6rpx;
  color: #6E6659;
  font-size: 24rpx;
}
