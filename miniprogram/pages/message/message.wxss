.page-message {
  background: #F7F2E8;
  min-height: 100vh;
  /* 底部留白避开自定义 tabBar，否则「全部标记为已读」被压住 */
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
}

.message-tabs {
  background: rgba(245, 246, 248, 0.96);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.05);
  gap: 10rpx;
}

.tab-item {
  flex: 1;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: #8B97A3;
  position: relative;
  letter-spacing: 0;
  font-weight: 800;
  text-align: center;
  border-radius: 999rpx;
  transition: transform 0.2s ease, background 0.2s ease;
}

.tab-item.active {
  color: #542BC4;
  background: rgba(22, 160, 133, 0.1);
  font-weight: 900;
}

.tab-item.active::after {
  display: none;
}

.badge {
  position: absolute;
  top: 12rpx;
  right: 4rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  background: linear-gradient(135deg, #FF4D2E, #FF4D2E);
  color: #fff;
  font-size: 20rpx;
  border-radius: 16rpx;
  padding: 0 8rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.3);
}

.message-list {
  padding: 24rpx 22rpx;
}

.message-item {
  display: flex;
  align-items: flex-start;
  padding: 28rpx;
  margin-bottom: 18rpx;
  animation: fadeInUp 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.message-item.unread {
  background: rgba(22, 160, 133, 0.08);
  border-color: rgba(22, 160, 133, 0.14);
}

.message-icon-wrap {
  position: relative;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(22, 160, 133, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.message-icon {
  font-size: 36rpx;
}

.unread-dot {
  position: absolute;
  top: 2rpx;
  right: 2rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF4D2E, #FF4D2E);
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 107, 0.4);
}

.message-body {
  overflow: hidden;
}

.message-header {
  margin-bottom: 8rpx;
}

.message-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #14110F;
  letter-spacing: 0;
}

.message-time {
  font-size: 22rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.message-content {
  font-size: 26rpx;
  color: #4A443C;
  line-height: 1.6;
  letter-spacing: 0;
}

.read-all {
  text-align: center;
  padding: 28rpx;
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 0;
}
