.load-more {
  padding: 38rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.loading text {
  font-size: 24rpx;
  color: #98A3AE;
  font-weight: 600;
  letter-spacing: 0;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid rgba(22, 160, 133, 0.1);
  border-top-color: #16A085;
  border-radius: 50%;
  animation: spin 0.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.load-text text {
  font-size: 24rpx;
  color: #98A3AE;
  font-weight: 600;
  letter-spacing: 0;
}
