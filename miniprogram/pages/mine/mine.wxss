.page-mine {
  background: #F5F6F8;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.profile-header {
  position: relative;
  margin-bottom: 24rpx;
}

.profile-bg {
  height: 240rpx;
  background:
    radial-gradient(circle at 18% 20%, rgba(255, 255, 255, 0.35), transparent 32%),
    linear-gradient(135deg, #16A085, #20C4A4);
  position: relative;
  overflow: hidden;
}

.profile-bg::after {
  content: '';
  position: absolute;
  bottom: -40rpx;
  left: -20%;
  width: 140%;
  height: 80rpx;
  background: #F5F6F8;
  border-radius: 50% 50% 0 0;
}

.profile-info {
  margin: -100rpx 24rpx 0;
  position: relative;
  z-index: 1;
  padding: 30rpx;
}

.profile-main {
  align-items: center;
  margin-bottom: 28rpx;
}

.profile-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 51, 0.12);
}

.profile-detail {
  margin-left: 24rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 900;
  color: #17202A;
  display: block;
  margin-bottom: 6rpx;
  letter-spacing: 0;
}

/* 用户信息卡：信誉徽章（CreditBadge 等价 WXSS 实现） */
.profile-name-row {
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.profile-name-row .profile-name {
  margin-bottom: 0;
}

.credit-badge {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.5;
  flex-shrink: 0;
}

.credit-badge.lv-gold {
  background: rgba(243, 156, 18, 0.14);
  color: #B9770E;
}

.credit-badge.lv-good {
  background: rgba(22, 160, 133, 0.12);
  color: #0E7C67;
}

.credit-badge.lv-normal {
  background: rgba(52, 152, 219, 0.12);
  color: #2471A3;
}

.credit-badge.lv-warn {
  background: rgba(230, 126, 34, 0.14);
  color: #BA4A00;
}

.credit-badge.lv-bad {
  background: rgba(231, 76, 60, 0.14);
  color: #C0392B;
}

.profile-signature {
  font-size: 24rpx;
  display: block;
  letter-spacing: 0;
}

.profile-edit {
  padding: 12rpx 20rpx;
  background: rgba(22, 160, 133, 0.1);
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.profile-stats {
  justify-content: space-around;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(15, 23, 42, 0.06);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-number {
  font-size: 36rpx;
  font-weight: 900;
  color: #17202A;
  letter-spacing: 0;
}

.stat-label {
  font-size: 22rpx;
  margin-top: 4rpx;
  letter-spacing: 0;
}

.menu-section {
  margin: 0 24rpx 22rpx;
  padding: 0 28rpx;
}

/* 交易评价区：均分 + 最近互评列表 */
.trade-ratings {
  margin: 0 24rpx 22rpx;
  padding: 26rpx 28rpx;
}

.tr-head {
  margin-bottom: 18rpx;
}

.tr-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #17202A;
}

.tr-avg {
  font-size: 28rpx;
  font-weight: 900;
  color: #F39C12;
  margin-right: 12rpx;
}

.tr-count {
  font-size: 22rpx;
}

.tr-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.05);
}

.tr-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #EEF2F3;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.tr-body {
  overflow: hidden;
}

.tr-row {
  align-items: center;
}

.tr-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #26323D;
}

.tr-stars {
  font-size: 24rpx;
  color: #F39C12;
  letter-spacing: 2rpx;
}

.tr-comment {
  display: block;
  font-size: 24rpx;
  color: #4A555F;
  margin-top: 6rpx;
}

.tr-meta {
  display: block;
  font-size: 22rpx;
  margin-top: 6rpx;
}

.tr-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
}

.menu-item {
  padding: 32rpx 0;
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.05);
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.menu-item:active {
  transform: scale(0.985);
  opacity: 0.86;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  align-items: center;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.menu-text {
  font-size: 30rpx;
  color: #17202A;
  letter-spacing: 0;
  font-weight: 700;
}

.menu-arrow {
  font-size: 28rpx;
  color: #DFE6E9;
}

.unread-badge {
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  background: linear-gradient(135deg, #FF6B6B, #EE5A24);
  color: #fff;
  font-size: 20rpx;
  border-radius: 16rpx;
  padding: 0 8rpx;
  margin-right: 12rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.3);
}
