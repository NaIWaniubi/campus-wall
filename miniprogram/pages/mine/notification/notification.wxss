.page-notification {
  background: #F7F2E8;
  min-height: 100vh;
  padding: 24rpx;
}

.notification-tabs {
  background: #FFFFFF;
  border-radius: 22rpx;
  padding: 10rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(20, 17, 15, 0.05);
}

.notification-tabs .tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #4A443C;
  border-radius: 16rpx;
}

.notification-tabs .tab-item.active {
  background: rgba(109, 59, 245, 0.1);
  color: #542BC4;
  font-weight: 800;
}

.notification-item {
  display: flex;
  align-items: flex-start;
  padding: 28rpx;
  margin-bottom: 18rpx;
  animation: fadeInUp 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.notification-item.unread {
  background: rgba(109, 59, 245, 0.08);
  border-color: rgba(109, 59, 245, 0.14);
}

.notification-icon-wrap {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(109, 59, 245, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.notification-icon {
  font-size: 36rpx;
}

.notification-body {
  overflow: hidden;
}

.notification-header {
  margin-bottom: 8rpx;
}

.notification-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #14110F;
  letter-spacing: 0;
}

.notification-time {
  font-size: 22rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.notification-content {
  font-size: 26rpx;
  color: #4A443C;
  line-height: 1.6;
  letter-spacing: 0;
}
