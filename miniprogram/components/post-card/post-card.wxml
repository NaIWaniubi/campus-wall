<view class="post-card {{perfLow ? 'post-card--perf-low' : ''}}" bindtap="onTapCard">
  <!-- 封面优先（小红书式）：单图/多图取首图做 cover，板块徽章与已售角标浮层 -->
  <view class="pc-cover" wx:if="{{hasCover}}">
    <image class="pc-cover-img" src="{{coverImage}}" mode="aspectFill" lazy-load binderror="onErrorImage" data-index="0"></image>
    <view class="pc-cover-badges">
      <view class="pc-badge" style="background-color: {{categoryColor}}; color: #fff;">{{categoryName}}</view>
      <view class="pc-badge pc-badge--sold" wx:if="{{isSold}}">✓ 已售</view>
    </view>
  </view>

  <view class="pc-body">
    <!-- 无封面卡片：板块徽章内联，信息不丢失 -->
    <view class="pc-category-inline" wx:if="{{!hasCover}}" style="background-color: {{categoryColor}}18; color: {{categoryColor}}">{{categoryName}}</view>

    <view class="pc-title" wx:if="{{post.title}}">{{post.title}}</view>
    <view class="pc-summary" wx:if="{{post.content}}">{{post.content}}</view>

    <view class="pc-extras" wx:if="{{post.extra.price || post.extra.condition || post.extra.tradeMethod || post.extra.reward || post.extra.deadline}}">
      <text class="pc-price" wx:if="{{post.extra.price}}">¥{{post.extra.price}}</text>
      <text class="pc-tag" wx:if="{{post.extra.condition}}">{{post.extra.condition}}</text>
      <text class="pc-tag" wx:if="{{post.extra.tradeMethod}}">{{post.extra.tradeMethod}}</text>
      <text class="pc-tag pc-tag--warn" wx:if="{{post.extra.reward}}">悬赏 ¥{{post.extra.reward}}</text>
      <text class="pc-tag pc-tag--warn" wx:if="{{post.extra.deadline}}">截止 {{post.extra.deadline}}</text>
    </view>

    <!-- 多图：三列九宫格（单图已上封面，不再重复） -->
    <view class="pc-grid" wx:if="{{gridImages.length > 1}}">
      <view class="pc-grid-item" wx:for="{{gridImages}}" wx:key="*this" catchtap="onPreviewImage" data-index="{{index}}">
        <image src="{{item}}" mode="aspectFill" lazy-load binderror="onErrorImage" data-index="{{index}}"></image>
      </view>
    </view>

    <view class="pc-location" wx:if="{{post.location}}">📍 {{post.location}}</view>

    <view class="pc-footer">
      <view class="pc-author">
        <image class="pc-avatar" src="{{post.author.isAnonymous ? '/images/default_avatar.png' : (post.author.avatar || '/images/default_avatar.png')}}" mode="aspectFill" lazy-load></image>
        <text class="pc-author-name">{{post.author.nickname || '校园同学'}}</text>
        <text class="pc-credit pc-credit--{{creditTier}}" wx:if="{{showCredit}}">信誉{{post.author.creditScore}}</text>
        <text class="pc-dot">·</text>
        <text class="pc-time">{{timeAgoText}}{{post.campus ? ' · ' + post.campus : ''}}</text>
      </view>
      <view class="pc-actions">
        <view class="pc-action {{post.isLiked ? 'pc-action--liked' : ''}}" catchtap="onLike" data-id="{{post.id}}">
          <text class="pc-action-symbol">{{post.isLiked ? '♥' : '♡'}}</text><text>{{post.likes}}</text>
        </view>
        <view class="pc-action" catchtap="onComment" data-id="{{post.id}}">
          <text class="pc-action-symbol">◌</text><text>{{post.comments}}</text>
        </view>
        <view class="pc-action {{post.isFavorited ? 'pc-action--fav' : ''}}" catchtap="onFavorite" data-id="{{post.id}}">
          <text class="pc-action-symbol">{{post.isFavorited ? '★' : '☆'}}</text><text>{{post.favorites}}</text>
        </view>
        <button class="pc-action pc-share" open-type="share" catchtap="onShare" data-id="{{post.id}}">
          <text class="pc-action-symbol">↗</text><text>分享</text>
        </button>
      </view>
    </view>
  </view>
</view>
