.conversation {
  position: relative;
  display: flex;
  align-items: center;
  padding: 26rpx;
  margin-bottom: 18rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 28rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.05);
  box-shadow: 0 16rpx 42rpx rgba(15, 23, 42, 0.06);
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.conversation:active {
  transform: scale(0.985);
  opacity: 0.92;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.main {
  flex: 1;
  min-width: 0;
}

.top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.name {
  color: #14110F;
  font-size: 30rpx;
  font-weight: 800;
}

.time {
  color: #9AA5B1;
  font-size: 22rpx;
}

.last {
  display: block;
  color: #6E6659;
  font-size: 26rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.badge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #FF4D2E, #EF4444);
  color: #FFFFFF;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
  box-shadow: 0 6rpx 14rpx rgba(239, 68, 68, 0.24);
}
