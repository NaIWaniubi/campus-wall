.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx var(--space-12, 60rpx);
}

.empty-state--animated {
  animation: fadeInUp 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.empty-state--small {
  padding: 80rpx 40rpx;
}

.empty-state--small .empty-state__image {
  width: 160rpx;
  height: 160rpx;
}

.empty-state--small .empty-state__icon-text {
  font-size: 80rpx;
}

.empty-state--small .empty-state__text {
  font-size: 26rpx;
}

.empty-state--small .empty-state__sub-text {
  font-size: 22rpx;
}

.empty-state__icon-wrap {
  margin-bottom: 28rpx;
  animation: float 4s ease-in-out infinite;
}

.empty-state__image {
  width: 240rpx;
  height: 240rpx;
  opacity: 0.72;
}

.empty-state__icon-text {
  font-size: 120rpx;
  display: block;
  text-align: center;
  filter: grayscale(0.15);
}

.empty-state__text {
  color: #7B8794;
  font-size: var(--font-size-body, 28rpx);
  margin-bottom: var(--space-3, 12rpx);
  font-weight: var(--font-weight-bold, 700);
  letter-spacing: 0;
  text-align: center;
  line-height: 1.6;
}

.empty-state__sub-text {
  color: #98A3AE;
  font-size: 24rpx;
  margin-bottom: 36rpx;
  letter-spacing: 0;
  text-align: center;
  line-height: 1.5;
  max-width: 480rpx;
}

.empty-state__btn {
  background: linear-gradient(135deg, var(--color-brand, #16A085), var(--color-brand-soft, #20C4A4));
  color: var(--color-text-inverse, #fff);
  border-radius: var(--radius-pill, 999rpx);
  padding: 18rpx 52rpx;
  font-size: var(--font-size-body, 28rpx);
  font-weight: var(--font-weight-extra, 800);
  letter-spacing: 0;
  box-shadow: 0 14rpx 30rpx rgba(22, 160, 133, 0.2);
  margin-top: var(--space-3, 12rpx);
  transition: all 0.25s ease;
}

.empty-state__btn--outline {
  background: rgba(22, 160, 133, 0.06);
  color: #16A085;
  border: 1rpx solid rgba(22, 160, 133, 0.24);
  box-shadow: none;
  margin-top: 16rpx;
}

.empty-state__btn--outline.empty-state__btn--hover {
  background: rgba(22, 160, 133, 0.08);
  border-color: #16A085;
}

.empty-state__btn--hover {
  opacity: 0.85;
  transform: scale(0.97);
  box-shadow: 0 4rpx 16rpx rgba(22, 160, 133, 0.14);
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-12rpx);
  }
}
