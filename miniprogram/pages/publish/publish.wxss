.page-publish {
  padding-bottom: 212rpx;
  background: #F7F2E8;
  min-height: 100vh;
}

.publish-form {
  padding: 24rpx 22rpx;
}

.label {
  font-size: 28rpx;
  font-weight: 800;
  color: #14110F;
  margin-bottom: 20rpx;
  display: block;
  letter-spacing: 0;
}

.category-scroll {
  white-space: nowrap;
  width: 100%;
}
.category-row {
  display: inline-flex;
  gap: 14rpx;
  padding: 4rpx 0 8rpx;
}
.category-option {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #F7F2E8;
  white-space: nowrap;
  border: 1rpx solid rgba(20, 17, 15, 0.05);
  transition: transform 0.22s ease, opacity 0.22s ease, background 0.22s ease, box-shadow 0.22s ease;
}

.category-option:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.category-option.active {
  background: rgba(109, 59, 245, 0.1);
  border-color: rgba(109, 59, 245, 0.2);
  box-shadow: 4rpx 4rpx 0 rgba(20, 17, 15, 0.12);
}

.category-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.category-name {
  font-size: 24rpx;
  color: #14110F;
  font-weight: 600;
  letter-spacing: 0;
}

.subtype-list {
  gap: 12rpx;
}

.subtype-option {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #F7F2E8;
  font-size: 26rpx;
  color: #4A443C;
  letter-spacing: 0;
  border: 1rpx solid rgba(20, 17, 15, 0.05);
  transition: transform 0.22s ease, opacity 0.22s ease, background 0.22s ease;
}

.subtype-option.active {
  background: rgba(109, 59, 245, 0.1);
  color: #542BC4;
  border-color: rgba(109, 59, 245, 0.2);
  font-weight: 800;
}

.identity-toggle {
  padding: 26rpx 30rpx;
}

.identity-hint {
  font-size: 24rpx;
  margin-left: 12rpx;
  letter-spacing: 0;
}

.anon-note {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
}

.title-input {
  position: relative;
}

.title-field {
  font-size: 32rpx;
  min-height: 72rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  background: #F7F2E8;
  color: #14110F;
  letter-spacing: 0;
}

.char-count {
  font-size: 22rpx;
  text-align: right;
  margin-top: 12rpx;
  letter-spacing: 0;
}

.content-input {
  position: relative;
}

.content-field {
  width: 100%;
  min-height: 230rpx;
  font-size: 28rpx;
  line-height: 1.8;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #F7F2E8;
  color: #14110F;
  letter-spacing: 0;
}

.content-footer {
  margin-top: 8rpx;
}

.topic-btn {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(109, 59, 245, 0.08);
}

.topic-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}

.topic-tag {
  display: flex;
  align-items: center;
  padding: 10rpx 24rpx;
  background: rgba(109, 59, 245, 0.1);
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #542BC4;
  font-weight: 700;
  letter-spacing: 0;
}

.topic-remove {
  margin-left: 12rpx;
  font-size: 28rpx;
  color: #6E6659;
}

.hot-topics {
  margin-top: 0;
}

.topic-grid {
  gap: 12rpx;
}

.hot-topic {
  padding: 10rpx 24rpx;
  background: #F7F2E8;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #4A443C;
  letter-spacing: 0;
  border: 1rpx solid rgba(20, 17, 15, 0.04);
}

.image-upload {
  margin-top: 0;
}

.image-list {
  gap: 14rpx;
}

.image-item {
  position: relative;
  width: calc((100% - 28rpx) / 3);
  height: 200rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background: #EFE8DA;
}

.image-item image {
  width: 100%;
  height: 100%;
}

.image-delete {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 48rpx;
  height: 48rpx;
  background: rgba(23, 32, 42, 0.58);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border-radius: 50%;
}

.image-add {
  width: calc((100% - 28rpx) / 3);
  height: 200rpx;
  border: 2rpx dashed rgba(109, 59, 245, 0.22);
  border-radius: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(109, 59, 245, 0.035);
  transition: transform 0.22s ease, opacity 0.22s ease;
}

.image-add:active {
  transform: scale(0.96);
  opacity: 0.86;
}

.add-icon {
  font-size: 52rpx;
  color: #6D3BF5;
  line-height: 1;
}

.add-text {
  font-size: 22rpx;
  color: #542BC4;
  margin-top: 8rpx;
  font-weight: 600;
  letter-spacing: 0;
}

.extra-fields {
  margin-top: 0;
}

.field-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(20, 17, 15, 0.06);
}

.field-item:last-child {
  border-bottom: none;
}

.field-label {
  font-size: 28rpx;
  color: #14110F;
  flex-shrink: 0;
  width: 200rpx;
  letter-spacing: 0;
}

.field-item input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #14110F;
  letter-spacing: 0;
}

.field-item picker {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #14110F;
  letter-spacing: 0;
}

.campus-select {
  margin-top: 0;
}

.campus-picker {
  padding: 22rpx 0;
  font-size: 28rpx;
  color: #14110F;
  letter-spacing: 0;
}

.publish-bar {
  position: fixed;
  bottom: 18rpx;
  left: 18rpx;
  right: 18rpx;
  padding: 18rpx;
  background: #FFFFFF;
  box-shadow: 6rpx 6rpx 0 rgba(20, 17, 15, 0.14);
  border: 1rpx solid rgba(20, 17, 15, 0.06);
  border-radius: 34rpx;
  z-index: 100;
}

.publish-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 32rpx;
  letter-spacing: 2rpx;
  border-radius: 28rpx;
}

.publish-tip {
  display: block;
  margin-bottom: 12rpx;
  color: #6E6659;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
  letter-spacing: 0;
}

.publish-tip.ready {
  color: #542BC4;
}

.publish-btn[disabled] {
  background: #D7DEE2;
  color: rgba(255, 255, 255, 0.6);
  box-shadow: none;
}

/* ---------- 图片区（B-T6 补回丢失的 UI，6 张上限与 publish.js 一致） ---------- */
.media-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 14rpx;
}
.media-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background: #F7F2E8;
}
.media-item image {
  width: 100%;
  height: 100%;
  display: block;
}
.media-remove {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(23, 32, 42, 0.55);
  color: #fff;
  font-size: 30rpx;
  text-align: center;
  line-height: 38rpx;
}
.media-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #C9CDD4;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FAFAFB;
}
.media-add-plus {
  font-size: 56rpx;
  color: #C9CDD4;
  line-height: 1;
}
