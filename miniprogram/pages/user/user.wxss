.page-user {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.user-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 32rpx 28rpx;
  margin-bottom: 24rpx;
}

.user-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background-color: #eef1f4;
}

.user-name {
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2d3d;
}

.user-signature {
  margin-top: 10rpx;
  max-width: 100%;
  font-size: 26rpx;
  color: #7b8794;
}

.user-meta {
  margin-top: 12rpx;
  gap: 16rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #98a3ae;
}

.credit-badge {
  margin-top: 18rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #fff;
  background-color: #16a085;
}
.credit-badge.lv-gold { background-color: #d4a017; }
.credit-badge.lv-good { background-color: #2f9e6e; }
.credit-badge.lv-normal { background-color: #16a085; }
.credit-badge.lv-warn { background-color: #e08a1e; }
.credit-badge.lv-bad { background-color: #d9534f; }

.user-actions {
  margin-top: 26rpx;
}

.action-primary,
.action-secondary {
  min-width: 220rpx;
  padding: 16rpx 0;
  text-align: center;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.action-primary {
  color: #fff;
  background-color: #16a085;
}

.action-secondary {
  color: #16a085;
  border: 1rpx solid #16a085;
}

.user-stats {
  margin-top: 32rpx;
  width: 100%;
  border-top: 1rpx solid #eef1f4;
  padding-top: 24rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 26rpx;
  color: #4a5763;
}

.section-title {
  margin: 8rpx 4rpx 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2d3d;
}

.list-end {
  text-align: center;
  font-size: 24rpx;
  padding: 24rpx 0;
}