.page-profile {
  background: #F7F2E8;
  min-height: 100vh;
  padding: 24rpx;
}

.form-item {
  padding: 30rpx;
  margin-bottom: 18rpx;
}

.form-label {
  font-size: 30rpx;
  color: #14110F;
  flex-shrink: 0;
  font-weight: 800;
  letter-spacing: 0;
}

.form-value {
  font-size: 28rpx;
  color: #4A443C;
  max-width: 400rpx;
  letter-spacing: 0;
}

.form-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 3rpx 3rpx 0 rgba(20, 17, 15, 0.10);
}

.form-arrow {
  font-size: 28rpx;
  margin-left: 12rpx;
  color: #DFE6E9;
}

.login-section,
.logout-section {
  margin-top: 48rpx;
  padding: 0 20rpx;
}

.login-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 32rpx;
  letter-spacing: 2rpx;
}

.auth-tabs {
  display: flex;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.auth-tab {
  font-size: 30rpx;
  color: #8A8F99;
  padding: 6rpx 4rpx;
}

.auth-tab--active {
  color: #1F2329;
  font-weight: 800;
  border-bottom: 4rpx solid #FF4D2E;
}

.auth-input {
  width: 100%;
  height: 88rpx;
  padding: 0 28rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 20rpx;
  font-size: 28rpx;
}

.logout-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 32rpx;
  background: #FFFFFF;
  color: #FF4D2E;
  border: 1rpx solid rgba(255, 77, 46, 0.24);
  border-radius: 999rpx;
  letter-spacing: 2rpx;
  font-weight: 800;
}

.logout-btn::after {
  border: none;
}

.auth-agree {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin: 4rpx 0 12rpx;
}
.auth-agree-box {
  transform: scale(0.85);
  flex-shrink: 0;
}
.auth-agree-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: #6b7280;
}
.auth-agree-link {
  color: #7c5cff;
  font-weight: bold;
}
