.page-category {
  padding: 24rpx;
  /* 底部留白避开自定义 tabBar（104rpx + 安全区），否则「校园活动」卡与按钮被压住 */
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
  background: #F7F2E8;
  min-height: 100vh;
}

.topic-header {
  margin-bottom: 28rpx;
  padding: 8rpx 4rpx 0;
}

.topic-title {
  display: block;
  color: #14110F;
  font-size: 44rpx;
  font-weight: 900;
  letter-spacing: -0.8rpx;
}

.topic-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #6E6659;
  font-size: 26rpx;
}

.category-grid {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.category-card {
  background: #FFFFFF;
  border-radius: 30rpx;
  padding: 30rpx;
  box-shadow: 6rpx 6rpx 0 rgba(20, 17, 15, 0.14);
  border: 1rpx solid rgba(20, 17, 15, 0.05);
  position: relative;
  overflow: hidden;
  animation: fadeInUp 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  transition: transform 0.22s ease, opacity 0.22s ease;
}

.category-card:active {
  transform: scale(0.985);
  opacity: 0.92;
}

.category-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 6rpx;
  height: 100%;
  border-radius: 0 3rpx 3rpx 0;
}

.category-card-header {
  margin-bottom: 20rpx;
}

.category-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.category-card-name {
  font-size: 32rpx;
  font-weight: 900;
  color: #14110F;
  letter-spacing: 0;
}

.category-subtypes {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.subtype-text {
  font-size: 22rpx;
  color: #542BC4;
  padding: 8rpx 16rpx;
  background: rgba(109, 59, 245, 0.08);
  border-radius: 999rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.category-card-footer {
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(20, 17, 15, 0.06);
}

.post-count {
  font-size: 24rpx;
  letter-spacing: 0;
}

.category-card-footer .primary-color {
  font-size: 26rpx;
  font-weight: 800;
  letter-spacing: 0;
}
